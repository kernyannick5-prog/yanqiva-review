# Kopiere nach .env (wird nicht committet). ACHTUNG: Alle VITE_*-Variablen landen im
# öffentlichen Browser-Bundle – hier niemals Secrets, Tokens oder Passwörter eintragen.

# Öffentliche Basis der Redirect-URLs (Anzeige im Dashboard / QR-Code in Produktion)
VITE_REDIRECT_BASE=https://yanqiva-bewertung.de/r/

# Analytics-Feature-Flag. Standard: aus. Vor dem Einschalten Consent-Banner und
# Datenschutzerklärung anpassen (siehe src/lib/privacy/).
VITE_ANALYTICS_ENABLED=false

# Kein Karten-Snapshot im Build: Produktionskarten (Slug -> Google-Link) gehören nie in dieses öffentliche Repo, in Artefakte oder Logs.
